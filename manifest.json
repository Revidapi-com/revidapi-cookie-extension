{
  "manifest_version": 3,
  "name": "RevidAPI Social – Cookie Sync",
  "version": "1.1.0",
  "description": "Đồng bộ phiên đăng nhập Facebook / TikTok / Zalo về dashboard RevidAPI Social chạy trên máy bạn (127.0.0.1).",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.tiktok.com/*",
    "https://*.zalo.me/*",
    "https://zalo.me/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "RevidAPI Social", "default_popup": "popup.html" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
